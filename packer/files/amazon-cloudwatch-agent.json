{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "journald": {
        "collect_list": [
          {
            "log_group_name": "tdf-iroh-s3",
            "log_stream_name": "{instance_id}",
            "units": ["tdf-iroh-s3", "tdf-iroh-s3-cert-sync"],
            "retention_in_days": 90
          }
        ]
      }
    }
  }
}
