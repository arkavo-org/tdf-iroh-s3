[Unit]
Description=TDF-Iroh-S3 Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tdf-iroh-s3
Group=tdf-iroh-s3
ExecStartPre=/usr/local/bin/tdf-iroh-s3-bootstrap
ExecStart=/usr/local/bin/tdf-iroh-s3 --config /etc/tdf-iroh-s3/config.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
# Plain log lines (no ANSI colors) in the journal and CloudWatch Logs.
Environment=NO_COLOR=1

# Bind 443 for the HTTPS API as the unprivileged service user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tdf-iroh-s3 /etc/tdf-iroh-s3

[Install]
WantedBy=multi-user.target
